# OpenRouter brain
LLM_API_KEY=
CHAT_PASSWORD=change-me

# Mac chat + camera mode
ENABLE_DISPLAY=0
NOTIFICATION_APPROVAL_MODE=smart
ENABLE_CAMERA=1
ENABLE_REOLINK=0
ENABLE_TTS=0
ENABLE_STATUS_PUBLISH=0
ENABLE_WEB_SEARCH=0
ENABLE_ACTIVITY_LOG=1
CAMERA_BACKEND=auto
CAMERA_DEVICE_INDEX=0
CAMERA_ROTATION=0

# Local AARG Gemma 4 12B vision
VISION_PROVIDER=aarg_mlx
VISION_BASE_URL=http://127.0.0.1:8090/v1
VISION_MODEL=mlx-community/gemma-4-12B-it-4bit
VISION_AARG_MLX_DIR=/path/to/aarg_mlx
VISION_ENABLE_THINKING=1
VISION_THINKING_BUDGET=1024
VISION_MAX_TOKENS=350

# Lower-frequency mobile defaults
VISION_POLL_INTERVAL=300
MOTION_POLL_INTERVAL=3
